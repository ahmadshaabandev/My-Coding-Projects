                    },
                    {
                        "name": "fields",
                        "type": "array",
                        "label": "Template fields",
                        "help": "One item per placeholder of your template. A value may be text, a number, or a list mapped from an earlier module: for the repeated section of your template, map the list to the field \"items\".",
