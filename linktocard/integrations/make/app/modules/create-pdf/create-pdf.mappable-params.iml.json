                            {
                                "name": "key",
                                "type": "text",
                                "label": "Field",
                                "required": true,
                                "help": "The placeholder name: lower-case letters, digits and _, starting with a letter.",
                                "validate": {
                                    "pattern": "^[a-z][a-z0-9_]{0,31}$"
                                }
                            },
                            {
                                "name": "value",
                                "type": "any",
