[
    {
        "name": "url",
        "type": "url",
        "label": "Page URL",
        "required": true,
        "help": "The https:// address of the page, for example a new blog post."
    },
    {
        "name": "template",
        "type": "select",
        "label": "Template",
        "options": "rpc://listCardTemplates",
        "help": "A starter template or one of your own. Leave empty for the \"blog\" starter template. The starter templates and their fields are listed at https://linktocard.com/docs/html-css-templates#starter-templates."
    },
    {
        "name": "overrides",
        "type": "array",
        "label": "Overrides",
        "help": "Template fields to set yourself, for example the field \"title\" with a shorter headline. They replace what the page says.",
        "spec": [
            {
                "name": "key",
                "type": "text",
                "label": "Field",
                "required": true,
                "help": "The placeholder name: lower-case letters, digits and _, starting with a letter.",
                "validate": {
                    "pattern": "^[a-z][a-z0-9_]{0,31}$"
                }
            },
            {
                "name": "value",
                "type": "text",
                "label": "Value"
            }
        ]
    },
    {
        "name": "size",
        "type": "select",
        "label": "Size",
        "help": "Leave empty for Open Graph (1200 x 630).",
        "options": [
            {
                "label": "Open Graph (1200 x 630)",
                "value": "og"
            },
            {
                "label": "Square (1080 x 1080)",
                "value": "square"
            },
            {
                "label": "Portrait (1080 x 1350)",
                "value": "portrait"
            },
            {
                "label": "Email (1200 x 400)",
                "value": "email"
            }
        ]
    },
    {
        "name": "format",
        "type": "select",
        "label": "Image format",
        "help": "Leave empty for PNG.",
        "options": [
            {
                "label": "PNG",
                "value": "png"
            },
            {
                "label": "JPEG",
                "value": "jpeg"
            },
            {
                "label": "WebP",
                "value": "webp"
            }
        ]
    }
]
