{
  // Type-checks the plain JavaScript app (JSDoc types, zapier-platform-core's own .d.ts) without
  // a build step: Zapier runs index.js as it is. `npm run typecheck`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["index.js", "lib/**/*.js", "creates/**/*.js", "searches/**/*.js"]
}
