# Response headers for static assets (Workers Static Assets reads this file).
# Responses produced by the Worker (/v1, /api, /auth, ...) set their own headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  # PADDLE: every https://cdn.paddle.com and https://*.paddle.com entry in the next line, plus 'unsafe-inline' in style-src, exists only for the Paddle.js overlay checkout (pricing page, dashboard). Paddle's exact CSP requirements were NOT verified: test a sandbox checkout with the browser console open before go-live and adjust this one line.
  # WEB ANALYTICS: https://static.cloudflareinsights.com (script-src) and https://cloudflareinsights.com (connect-src) are for Cloudflare Web Analytics, which the zone injects into every HTML page for browsers (owner decision of 2026-11-27; the privacy policy names it). On this proxied zone the beacon reports to /cdn-cgi/rum on the same origin ('self'); the second host is the one Cloudflare's CSP reference lists.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.paddle.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://*.paddle.com; img-src 'self' data: blob: https://*.paddle.com; font-src 'self'; connect-src 'self' https://*.paddle.com https://cloudflareinsights.com; frame-src https://*.paddle.com https://challenges.cloudflare.com; form-action 'self' mailto:; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

# CSS, JS, images and fonts have no content hash in their names, so they must not be cached as immutable.
/assets/*
  Cache-Control: public, max-age=3600

# The footer that the Worker puts on the pages it renders (/v/...): a fragment, not a page to index.
/assets/partials/*
  X-Robots-Tag: noindex

# Twemoji SVGs, loaded by the image renderer.
/_emoji/*
  Cache-Control: public, max-age=86400
