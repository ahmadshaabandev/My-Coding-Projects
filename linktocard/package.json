{
  "name": "linktocard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Link To Card - HTML/CSS templates to Open Graph images on Cloudflare Workers (Satori + resvg-wasm)",
  "scripts": {
    "dev": "npm run build:site && wrangler dev",
    "build:site": "tsx scripts/build-site.ts",
    "test": "npm run build:site && vitest run && vitest run -c vitest.node.config.ts",
    "test:workers": "vitest run",
    "test:node": "vitest run -c vitest.node.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "smoke": "node scripts/smoke.mjs",
    "samples": "node scripts/render-samples.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "probes": "PROBES=1 vitest run --silent=false",
    "build:dry": "npm run build:site && wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:staging": "SITE_PDF=on npm run build:site && wrangler deploy --env staging",
    "deploy:production": "npm run check:golive && SITE_PDF=off npm run build:site && wrangler deploy --env production",
    "check:golive": "tsx scripts/build-site.ts --check-golive",
    "deploy:www": "wrangler deploy -c redirect/wrangler.toml"
  },
  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/webp": "1.5.0",
    "@resvg/resvg-wasm": "2.6.2",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "harfbuzzjs": "0.10.0",
    "hono": "4.13.19",
    "htmlparser2": "12.0.0",
    "satori": "0.63.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@twemoji/svg": "15.0.0",
    "@types/node": "22.20.5",
    "marked": "18.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": ">=22"
  }
}
